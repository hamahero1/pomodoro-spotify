# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

# Flask
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
FLASK_ENV=development
FLASK_DEBUG=1

# Spotify (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/spotify/callback

# Database
DATABASE_URL=sqlite:///pomodoro.db
