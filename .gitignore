# Environment / secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/
env/
build/
dist/

# Database
*.db
*.sqlite
*.sqlite3
instance/

# Notes (user content, not source) — ** matches folder subdirectories too
# (notes/files/<folder>/*.md), unlike the plain * this used before, which
# only covered files directly in notes/files/ and let a personal note
# saved into a folder slip through as an untracked file ready to be added.
notes/files/**/*.md
notes/files/*.md
!notes/files/.gitkeep

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
excalidraw.log
p.py
server_out.log
server_err.log
server.pid

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
